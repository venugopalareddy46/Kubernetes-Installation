# 1. Stop Kubernetes services
sudo systemctl stop kubelet
sudo systemctl stop containerd


# 2. Reset kubeadm
sudo kubeadm reset -f


# 3. Remove Kubernetes packages
sudo apt-mark unhold kubeadm kubelet kubectl

sudo apt purge -y kubeadm kubelet kubectl kubernetes-cni


# 4. Remove Kubernetes configuration
sudo rm -rf /etc/kubernetes
sudo rm -rf /var/lib/kubelet
sudo rm -rf /var/lib/etcd


# 5. Remove CNI configuration
sudo rm -rf /etc/cni
sudo rm -rf /opt/cni


# 6. Remove kubectl configuration
rm -rf ~/.kube

sudo rm -rf /root/.kube


# 7. Remove Kubernetes APT repository
sudo rm -f /etc/apt/sources.list.d/kubernetes.list
sudo rm -f /etc/apt/keyrings/kubernetes-apt-keyring.gpg


# 8. Remove Kubernetes-related packages that are no longer needed
sudo apt autoremove -y


# 9. Reload systemd
sudo systemctl daemon-reload


# 10. Restart containerd
sudo systemctl enable containerd
sudo systemctl start containerd


# 11. Clean remaining Kubernetes networking state
sudo ip link delete cni0 2>/dev/null || true
sudo ip link delete flannel.1 2>/dev/null || true

sudo systemctl stop containerd

sudo apt purge -y containerd

sudo rm -rf /etc/containerd
sudo rm -rf /var/lib/containerd

sudo apt autoremove -y

# 12. Reboot
sudo reboot